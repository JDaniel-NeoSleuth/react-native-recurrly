{
  "expo": {
    "name": "react_native-recurrly",
    "slug": "react_native-recurrly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "react_native-recurrly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      // CORREÇÃO: reactCompiler desabilitado (mudou de true para false).
      // O React Compiler é incompatível com o Expo Go — ele requer um dev client compilado
      // (EAS Build ou expo run:ios/android). Com Expo Go, o reactCompiler causa erro 500
      // porque o código compilado não roda no ambiente genérico do Expo Go.
      // Se quiser usar o React Compiler no futuro, precisa criar um dev client com:
      //   npx expo run:ios  ou  npx expo run:android  (local)
      //   eas build --profile development  (nuvem)
      "reactCompiler": false
    }
  }
}
